{
  "description": "Corpus-ablation configuration used for the paper's pretraining corpus (an independent draw per token occurrence). Seed is per-shard (set at launch); resources resolve inside sambal/resources/.",
  "config": {
    "spacy_model": "en_core_web_trf",
    "require_gpu": true,
    "replace_propn": true,
    "replace_pronouns": false,
    "roundtrip_ud": true,
    "roundtrip_max_tries": 4,
    "freeze_aux_hosts": false,
    "min_vocab_freq": 1,
    "respect_human": true,
    "respect_gender": true,
    "verb_metrics": false,
    "prefilter_pools_by_allowed_vocab": true,
    "filter_substitution_names_by_allowed_vocab": true,
    "ctx_lemma_gate": "freq",
    "ctx_lemma_gate_min_count": 2,
    "vn_soft_prep_min_pool": 10,
    "ctx_backoff_mode": "B",
    "ctx_backoff_min_lemma_count": 2,
    "ctx_backoff_min_candidates": 2,
    "ctx_backoff_min_candidates_pct": 0.05,
    "skip_toinf_freeze": false,
    "debug": false,
    "roundtrip_debug": false,
    "debug_vn": false
  },
  "resources": {
    "verbnet_source": "nltk",
    "function_words_path": "function_words_ud_ewt.txt",
    "npi_path": "english_npis_wiktionary.tsv",
    "noun_lemmas_path": "wordnet_nouns.jsonl",
    "adj_lemmas_path": "wordnet_adjectives.jsonl",
    "adv_lemmas_path": "wordnet_adverbs.jsonl",
    "propn_list_path": "allowed_proper_nouns.txt",
    "given_names_path": "given_names_ssa.txt",
    "fixed_mwes_path": "fixed_mwes_all.txt",
    "mwe_patterns_jsonl_path": "streusle_vmwe_patterns.jsonl",
    "human_nouns_path": "human_nouns.jsonl",
    "allowed_vocab_path": "allowed_vocab.txt",
    "licensor_patterns_jsonl_path": "licensor_patterns_full.jsonl",
    "toinf_verb_lexicon_jsonl": "toinf_verbs.jsonl",
    "toinf_adj_lexicon_jsonl": "toinf_adjs.jsonl",
    "given_names_male_path": "male_given_names.txt",
    "given_names_female_path": "female_given_names.txt",
    "given_names_neutral_path": "neutral_given_names.txt",
    "gendered_words_json_path": "gendered_words_filtered.json",
    "ctx_lemma_stats_path": "lemma_stats_top_25k.pkl"
  }
}
